# Realitas local/runtime configuration template.
# Copy to .env locally or to /etc/realitas/realitas.env on the VPS.
# Keep real secret values in Bitwarden; never commit populated .env files.

# Optional AI/provider secrets; retrieve real values from Bitwarden when needed.
OPENAI_API_KEY=

# Visualizer viewer defaults for the current Python checkout.
VIS_VIEWER_HOST=127.0.0.1
VIS_VIEWER_PORT=8765

# Deployment metadata used by scripts/deploy-realitas.sh.
# Local/default path uses the SSH config host `realitas-dev`; GitHub Actions overrides this to the public IP.
REALITAS_DEPLOY_HOST=realitas-dev
REALITAS_DEPLOY_USER=root
REALITAS_DEPLOY_SSH_KEY=/Users/frankmcalvarez/.ssh/hetzner_realitas
REALITAS_REMOTE_DIR=/home/deploy/realitas
REALITAS_SERVICE_NAME=realitas.service
REALITAS_REPO_URL=https://github.com/francoislejunk/realitas.git
REALITAS_BRANCH=main
REALITAS_HEALTH_URL=http://127.0.0.1:3000/health
REALITAS_START_CMD=/usr/bin/node server.js
REALITAS_DEPLOY_CONFIRM=
REALITAS_ENABLE_NGINX=0
