class DeciderAgent:
    """
    The Decider Agent, responsible for determining Non-User Actor (NUA)
    and Inanimate Non-User Actor (INUA) actions and reactions in the simulation.
    """

    def __init__(self, logger: 'UTASLogger', scene_description: str, tracker_agent=None):
        self.logger = logger
        self.scene_description = scene_description
        self.tracker_agent = tracker_agent
        
        if not tracker_agent:
            logger.log_system("WARNING: DeciderAgent initialized without tracker_agent. Action variety may be compromised.")
        # Set a 5-minute timeout for the client
        self.client = create_role_client("decision_making")
        self.model = OpenRouterConfig.get_model_for_role("decision_making")
        
        self.response_cache = {}
        self.cache_hits = 0
        self.cache_misses = 0
        print("Decider Agent initialized.")

    def _refresh_scene_from_tracker(self) -> None:
        """Update self.scene_description from TrackerAgent if available."""
        try:
            if getattr(self, 'tracker_agent', None):
                latest = self.tracker_agent.get_current_scene() or {}
                latest_desc = latest.get('scene_description')
                if latest_desc:
                    self.scene_description = latest_desc
        except Exception:
            # Non-fatal: keep current scene_description
            pass

    def _get_historical_context(self, lookback_turns: int = 3) -> str:
        """Get recent turn history for NUA decision context."""
        if not self.tracker_agent:
            return "\n**No historical context available**\n"
        
        try:
            context = self.tracker_agent.get_context_for_llm(lookback_turns)
            if context.strip():
                return f"\n**Recent Turn History:**\n{context}\n"
            else:
                return "\n**No previous turns recorded**\n"
        except Exception as e:
            self.logger.log_system(f"Error getting historical context: {e}")
            return "\n**Historical context unavailable**\n"
    
    def _get_recent_nua_actions(self, actor_name: str, lookback_turns: int = None) -> str:
        """Get ALL historical actions by this specific NUA to prevent repetition."""
        if not self.tracker_agent:
            return "No action history available - be creative and varied!"
        
        try:
            actor_id = f"actor_{actor_name.lower().replace(' ', '_')}"
            all_actions = self.tracker_agent.get_actor_history(actor_id)
            
            # Debug logging
            self.logger.log_system(f"DEBUG: Looking for actor_id: {actor_id}")
            self.logger.log_system(f"DEBUG: Found {len(all_actions)} total actions for {actor_name}")
            
            if not all_actions:
                return "No previous actions recorded - be creative!"
            
            historical_actions = []
            proactor_turns = 0
            
            for i, turn_data in enumerate(all_actions):
                role = turn_data.get("role", "unknown")
                turn_info = turn_data.get("turn_data", {})
                
                self.logger.log_system(f"DEBUG: Turn {i+1} - Role: {role}")
                self.logger.log_system(f"DEBUG: Available keys in turn_info: {list(turn_info.keys())}")
                
                # Check multiple possible data structures
                action_desc = None
                if role == "proactor":
                    proactor_turns += 1
                    
                    # Try different possible data locations
                    if turn_info.get("step1_proactor_interpretation"):
                        step1_data = turn_info["step1_proactor_interpretation"]
                        if "normalized_output" in step1_data:
                            action_desc = step1_data["normalized_output"].get("action_description", "Unknown action")
                        elif "input_data" in step1_data:
                            action_desc = step1_data["input_data"].get("narrative_description", "Unknown action")
                    
                    # Fallback: look for any action description in the turn data
                    if not action_desc:
                        for key, value in turn_info.items():
                            if isinstance(value, dict):
                                if "action_description" in value:
                                    action_desc = value["action_description"]
                                    break
                                elif "narrative_description" in value:
                                    action_desc = value["narrative_description"]
                                    break
                    
                    if action_desc:
                        historical_actions.append(f"- {action_desc}")
                        self.logger.log_system(f"DEBUG: Found proactor action: {action_desc}")
                    else:
                        self.logger.log_system(f"DEBUG: No action description found in turn {i+1}")
            
            self.logger.log_system(f"DEBUG: {actor_name} was proactor in {proactor_turns} turns, found {len(historical_actions)} action descriptions")
            
            if historical_actions:
                return f"ALL historical actions by {actor_name}:\n" + "\n".join(historical_actions) + "\n\n**AVOID repeating ANY of these patterns! Create something completely new and different.**"
            else:
                return f"No historical actions found for {actor_name} - be creative and authentic!"
                
        except Exception as e:
            self.logger.log_system(f"Error getting recent NUA actions: {e}")
            return "Action history unavailable - focus on character authenticity!"

    def _call_llm_for_json(self, prompt: str) -> Optional[Dict[str, Any]]:
        """Calls the OpenRouter LLM and attempts to parse the response as JSON."""
        # Check if the prompt is in the cache
        prompt_hash = hashlib.sha256(prompt.encode()).hexdigest()
        if prompt_hash in self.response_cache:
            self.cache_hits += 1
            return self.response_cache[prompt_hash]
        
        self.cache_misses += 1
        
        try:
            response = self.client.chat.completions.create(
                model=self.model,
                messages=[{"role": "user", "content": prompt}],
                response_format={"type": "json_object"},
                temperature=0.7
            )
            response_text = response.choices[0].message.content
            print(f"{Color.SYSTEM}DEBUG: LLM raw response: {response_text[:300]}...{Color.RESET}")
            result = extract_and_parse_json(response_text)
            print(f"{Color.SYSTEM}DEBUG: extract_and_parse_json returned: {type(result)}, value: {str(result)[:200]}...{Color.RESET}")
            
            if result is None:
                print(f"{Color.SYSTEM}DEBUG: result is None, raising JSONDecodeError{Color.RESET}")
                raise json.JSONDecodeError("Could not extract valid JSON from response", response_text, 0)
            
            self.response_cache[prompt_hash] = result
            
            return result
        except json.JSONDecodeError as e:
            raw_response = response_text if 'response_text' in locals() else 'No response data'
            error_message = f"JSONDecodeError: {e}\nRaw Response:\n{raw_response}"
            self.logger.log_system(f"ERROR: {error_message}")
            return None
        except Exception as e:
            error_message = f"An unexpected error occurred with OpenRouter: {e}"
            self.logger.log_system(f"ERROR: {error_message}")
            return None

