[Unit]
Description=Realitas Web App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/realitas
EnvironmentFile=-/etc/realitas/realitas.env
ExecStart=/bin/bash -lc 'exec ${REALITAS_START_CMD:-/usr/bin/node server.js}'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/deploy/realitas

[Install]
WantedBy=multi-user.target
